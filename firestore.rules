rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow read/write for all application state documents (main, logs, clients chunks, current)
    match /appState/{document} {
      allow read, write: if true;
    }

    // Allow read/write for movement photos
    match /movementPhotos/{id} {
      allow read, write: if true;
    }
  }
}
